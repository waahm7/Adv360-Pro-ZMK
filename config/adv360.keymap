#include <dt-bindings/zmk/stp.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none           &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4  &kp N5  &none                                                                                   &mo 5              &kp NUMBER_6  &kp N7  &kp N8             &kp N9         &kp NUMBER_0  &none
&kp TAB         &kp Q              &kp W         &kp E             &kp R         &kp T   &kp LG(LA(D))                                                                           &kp LS(LC(LG(A)))  &kp Y         &kp U   &kp I              &kp O          &kp P         &kp BSLH
&kp ESCAPE      &kp A              &kp S         &kp D             &kp F         &kp G   &kp LG(LC(LS(I)))  &kp LEFT_CONTROL  &kp LEFT_ALT      &kp RIGHT_ALT  &kp LEFT_COMMAND  &none              &kp H         &kp J   &kp K              &kp L          &kp SEMI      &kp SQT
&kp LEFT_SHIFT  &kp Z              &kp X         &kp C             &kp V         &kp B                                        &none             &none                                               &kp N         &kp M   &kp COMMA          &kp DOT        &kp FSLH      &kp RIGHT_SHIFT
&trans          &kp LG(LS(SPACE))  &kp CAPSLOCK  &kp LEFT_COMMAND  &kp LC(B)             &kp BACKSPACE      &mo 2             &mo 3             &kp LG(SPACE)  &kp ENTER         &kp SPACE                        &none   &kp RIGHT_CONTROL  &kp LS(LG(J))  &none         &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 1      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 1
            >;
        };

        personal {
            bindings = <
&trans     &trans            &none                     &none              &none              &none              &trans                                                    &trans                &trans            &trans                &trans                 &trans             &trans         &trans
&trans     &trans            &kp LG(LC(LS(W)))         &kp LG(LC(LS(E)))  &kp LG(LS(LC(R)))  &kp LG(LS(LC(T)))  &kp LG(LS(NUMBER_4))                                      &kp LC(LA(UP_ARROW))  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp PLUS       &trans
&kp CARET  &kp PERCENT       &kp EQUAL                 &kp UNDER          &kp MINUS          &kp LC(LG(LS(G)))  &kp LA(LC(LEFT))      &trans  &trans      &trans  &trans  &kp LC(LA(RIGHT))     &kp LEFT          &kp DOWN_ARROW        &kp UP_ARROW           &kp RIGHT          &kp LG(LS(C))  &kp DOLLAR
&trans     &kp LG(NUMBER_1)  &kp LG(NUMBER_2)          &kp LG(NUMBER_3)   &kp LG(NUMBER_4)   &kp AT_SIGN                                      &trans      &trans                                &kp AMPERSAND     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp GRAVE          &kp ASTERISK   &kp TILDE
&trans     &trans            &kp LC(LG(LS(NUMBER_4)))  &trans             &trans                                &trans                &trans  &trans      &trans  &trans  &kp LC(LA(SPACE))                       &kp LA(LEFT_ARROW)    &kp LA(RIGHT_ARROW)    &trans             &trans         &trans
            >;
        };

        numbers {
            bindings = <
&trans  &trans  &trans            &trans            &trans            &trans            &trans                                      &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans            &trans            &trans            &trans            &trans                                      &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &trans  &trans  &trans      &trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans
&trans  &trans  &trans            &trans            &trans            &trans                            &trans      &trans                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &trans  &trans            &trans            &trans                              &trans  &trans  &trans      &trans  &trans  &trans                &trans        &trans        &trans        &trans        &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 5                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none   &trans  &trans      &trans  &trans  &none   &kp F6  &kp F7  &kp F8  &kp F9   &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans   &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
